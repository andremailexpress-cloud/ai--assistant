PORT=3001
NODE_ENV=development
# PostgreSQL connection string used by Prisma and the backend service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_assistant
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional dedicated secret if MFA pending-session JWTs are split from JWT_SECRET in a later hardening pass.
MFA_SESSION_SECRET=change-me-if-you-split-mfa-session-signing
GEMINI_API_KEY=your-gemini-api-key-here
DEV_ADMIN_EMAIL=dev-admin@example.com
DEV_ADMIN_PASSWORD=change-me-dev-only
DEV_ADMIN_MFA_SECRET=
